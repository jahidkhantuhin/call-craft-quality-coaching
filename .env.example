# Local portfolio preview works without an API.
APP_NAME=CallCraft
SHOWCASE_MODE=true

# Set an API URL and SHOWCASE_MODE=false to use the Laravel Sanctum backend.
API_BASE_URL=http://localhost:8000/api/v1
RECAPTCHA_SITE_KEY=

